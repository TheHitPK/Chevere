# ───────────── LOCAL (tu computadora) ─────────────
# Copia este archivo como .env y ajusta los valores.
PAYLOAD_SECRET=pon-aqui-una-cadena-larga-y-aleatoria
DATABASE_URL=file:./chevere.db
DB_PUSH=no
NEXT_PUBLIC_SERVER_URL=http://localhost:3210

# ───────────── NUBE (Vercel) ─────────────
# Estas variables NO van en este archivo: se escriben en Vercel → Settings → Environment Variables.
# Paso a paso en DESPLIEGUE.md.
#
# PAYLOAD_SECRET=            (cadena aleatoria de 32+ caracteres, distinta a la de local)
# DATABASE_URL=              (Neon, dirección "pooled": postgres://…-pooler…/neondb?sslmode=require)
# DATABASE_URL_UNPOOLED=     (Neon, dirección directa; la usan las migraciones)
# R2_ACCOUNT_ID=             (Cloudflare → R2 → Account ID)
# R2_BUCKET=                 (nombre del bucket, p. ej. chevere-media)
# R2_ACCESS_KEY_ID=          (token de API de R2)
# R2_SECRET_ACCESS_KEY=      (token de API de R2)
# R2_ENDPOINT=               (OPCIONAL: solo si tu bucket es de jurisdicción UE; normalmente se deja vacío)
# NEXT_PUBLIC_SERVER_URL=    (https://tu-dominio.com, sin barra final)
